# Hezil HES — kullanıcılar ve oturum ayarları
# Bu dosyayı '.env' olarak kopyalayın ve kendi değerlerinizle doldurun.
# .env GİT'E ASLA GÖNDERİLMEZ (güvenlik) — örnek olarak bu şablon yeterlidir.

# Kullanıcılar: KULLANICI_<N>_ADI / KULLANICI_<N>_SIFRE çiftleri (N = 1, 2, 3, …)
KULLANICI_1_ADI=ismet
KULLANICI_1_SIFRE=ornek_sifre_degistirin
KULLANICI_2_ADI=ayse
KULLANICI_2_SIFRE=baska_ornek_sifre

# Saniye cinsinden hareketsizlik süresi (varsayılan: 3600 = 1 saat; en az 10)
OTURUM_SURE_S=3600

# Giriş/çıkış kayıt dosyası (varsayılan: giris_cikis.log)
LOG_DOSYASI=giris_cikis.log

# Ters vekil (nginx/Caddy) arkasındaysanız gerçek istemci IP'si için vekilin
# adresini yazın; kayıtlara X-Forwarded-For'daki IP düşer. Boş bırakılırsa
# XFF yok sayılır (doğrudan erişimde zaten gerçek IP görünür).
# GUVENILIR_PROXY=127.0.0.1
